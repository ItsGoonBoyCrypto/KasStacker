{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@components/*": ["src/components/*"],
      "@layouts/*": ["src/layouts/*"],
      "@data/*": ["data/*"]
    }
  },
  "include": ["src/**/*", "data/*.json", "scripts/**/*"],
  "exclude": ["dist", "node_modules"]
}
