---
// Homepage strip: live repo facts from data/status.json (refreshed daily by CI).
import components from '@data/components.json';
import status from '@data/status.json';
import MaturityBadge from './MaturityBadge.astro';

type RepoStatus = {
  latestTag: string | null;
  latestTagDate: string | null;
  lastCommit: string;
  openIssues: number;
  stars: number;
  archived: boolean;
};
const repos = status.repos as Record<string, RepoStatus>;

const ago = (iso: string) => {
  const days = Math.floor((Date.now() - new Date(iso).getTime()) / 86_400_000);
  if (days <= 0) return 'today';
  if (days === 1) return '1 day ago';
  if (days < 60) return `${days} days ago`;
  return `${Math.floor(days / 30)} months ago`;
};
const rows = components
  .filter((c) => c.repo && repos[c.repo])
  .map((c) => ({ c, s: repos[c.repo as string] }));
const generated = new Date(status.generatedAt).toISOString().slice(0, 10);
---
<ul class="strip" aria-label="Live component status">
  {rows.map(({ c, s }) => (
    <li>
      <a class="cell" href={`/stack/${c.id}`}>
        <span class="name">{c.name}</span>
        <span class="fact">{s.latestTag ?? 'no release'}</span>
        <span class="fact dim">updated {ago(s.lastCommit)}</span>
        <MaturityBadge maturity={c.maturity} />
      </a>
    </li>
  ))}
  <li>
    <div class="cell meta">
      <span class="fact dim">from the GitHub API</span>
      <span class="fact dim">refreshed {generated}</span>
      <a href="/status">full status board →</a>
    </div>
  </li>
</ul>

<style>
  .strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 12px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .strip li { display: flex; }
  .cell {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
    background: var(--surface);
    border: 1px solid var(--border-soft);
    border-radius: 10px;
    padding: 14px 16px;
    color: var(--text);
  }
  a.cell:hover { text-decoration: none; border-color: var(--teal-dim); }
  .name { font-family: 'Sora', sans-serif; font-weight: 600; font-size: 0.9rem; }
  .fact {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .fact.dim { color: var(--faint); }
  .meta { justify-content: center; }
  .meta a { font-size: 0.8rem; }
</style>
