---
import Base from '@layouts/Base.astro';
import ComparisonMatrix from '@components/ComparisonMatrix.astro';
---
<Base
  title="Compare — KasStacker"
  description="The full comparison matrix for Kaspa's programmability stack — layer, state model, composability and honest maturity, side by side."
>
  <div class="wrap">
    <header class="head">
      <p class="eyebrow">Compare</p>
      <h1>The matrix</h1>
      <p class="lede">
        Every component side by side. "Unverified" means exactly that — the site never guesses a value
        it can't source. Maturity badges match the scale used everywhere on this site.
      </p>
    </header>
    <ComparisonMatrix />
    <p class="note">
      Head-to-head pages (Silverscript vs Argent, L1 covenants in depth) are on the roadmap —
      the matrix is the source of truth they will build on.
    </p>
  </div>
</Base>

<style>
  .head { padding: 56px 0 28px; }
  .head h1 { font-size: 2rem; font-weight: 700; margin: 8px 0 12px; }
  .lede { color: var(--muted); font-size: 1.05rem; max-width: 60ch; }
  .note { color: var(--faint); font-size: 0.85rem; margin-top: 16px; }
</style>
