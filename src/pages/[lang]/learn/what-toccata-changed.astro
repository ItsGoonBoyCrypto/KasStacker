---
import Base from '@layouts/Base.astro';
import Quiz from '@components/Quiz.astro';
import Exhibits from '@components/Exhibits.astro';
import { localePaths, loadDict } from '../../../i18n/index';

export function getStaticPaths() { return localePaths(); }
const { lang } = Astro.params;
const d = await loadDict(lang!);
const t = d.stop2;
---
<Base title={`${t.h1} — KasStacker`} description={t.quote} lang={lang}>
  <div class="wrap-narrow prose">
    <header class="head">
      <p class="eyebrow">{t.eyebrow}</p>
      <h1>{t.h1}</h1>
    </header>

    <p set:html={t.p1} />

    <div class="ba">
      <div class="col before">
        <h3>{t.beforeH3}</h3>
        <ul>{t.beforeItems.map((i) => <li set:html={i} />)}</ul>
      </div>
      <div class="col after">
        <h3>{t.afterH3}</h3>
        <ul>{t.afterItems.map((i) => <li set:html={i} />)}</ul>
      </div>
    </div>

    <h2>{t.h2Words}</h2>
    <ul>{t.words.map((w) => <li set:html={w} />)}</ul>

    <blockquote>{t.quote}</blockquote>

    <Exhibits />

    <Quiz page="what-toccata-changed" questions={d.quiz['what-toccata-changed']} labels={d.quizUi} resultHref="/learn/complete" />

    <div class="next-link"><a class="btn btn-primary" href={`/${lang}/learn/meet-the-stack/`}>{t.next}</a></div>
  </div>
</Base>

<style>
  .head { padding: 56px 0 16px; }
  .head h1 { font-size: 2rem; font-weight: 700; margin-top: 8px; }
  .ba { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 24px 0; }
  @media (max-width: 640px) { .ba { grid-template-columns: 1fr; } }
  .col { background: var(--surface); border: 1px solid var(--border-soft); border-radius: 10px; padding: 18px 20px; }
  .col h3 {
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .before h3 { color: var(--faint); }
  .after h3 { color: var(--teal); }
  .col ul { margin: 0; padding-left: 18px; }
</style>
