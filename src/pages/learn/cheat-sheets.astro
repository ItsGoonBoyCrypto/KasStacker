---
import Base from '@layouts/Base.astro';

const sheets = [
  {
    n: '01',
    file: '/sheets/the-stack.pdf',
    title: 'The Kaspa stack',
    blurb: 'All five layers on one page — what each does, what enforces what, and where you build.',
  },
  {
    n: '02',
    file: '/sheets/move-vs-enforce.pdf',
    title: 'Move vs enforce',
    blurb: 'The before/after of Toccata: Kaspa used to move money — now it enforces rules on it.',
  },
  {
    n: '03',
    file: '/sheets/what-is-a-covenant.pdf',
    title: 'What is a covenant?',
    blurb: 'A lock on coins with rules built in — with real example rules and what they unlock.',
  },
  {
    n: '04',
    file: '/sheets/three-things-you-can-build.pdf',
    title: 'Three things you can build today',
    blurb: 'Token, vault, or app — which part of the stack each one uses, all on Kaspa L1.',
  },
  {
    n: '05',
    file: '/sheets/which-tool.pdf',
    title: 'Which tool do I need?',
    blurb: 'One question at a time to the right tool — with an honest maturity label on each.',
  },
];
---
<Base
  title="Cheat sheets — KasStacker"
  description="The Kaspa stack on five one-page cheat sheets — the stack, covenants, what to build and which tool. Free to save, share and print."
>
  <div class="wrap-narrow">
    <header class="head">
      <p class="eyebrow">Learn · cheat sheets</p>
      <h1>The stack on five pages</h1>
      <p class="lede">
        The whole idea, one page at a time — made for saving, sharing and printing.
        Post them anywhere; they're free and always will be.
      </p>
    </header>

    <ol class="sheets">
      {sheets.map((s) => (
        <li>
          <a href={s.file} target="_blank" rel="noopener">
            <span class="n">{s.n}</span>
            <span class="body">
              <span class="t">{s.title}</span>
              <span class="b">{s.blurb}</span>
            </span>
            <span class="open">open<br />PDF →</span>
          </a>
        </li>
      ))}
    </ol>

    <p class="after">
      Want the interactive versions? The <a href="/learn">6-stop tour</a> covers the same ground with
      quizzes — and you can <a href="/learn/try-it">break a real covenant</a> yourself.
    </p>
  </div>
</Base>

<style>
  .head { padding: 56px 0 28px; }
  .head h1 { font-size: 2rem; font-weight: 800; margin: 8px 0 12px; }
  .lede { color: var(--muted); font-size: 1.05rem; }
  .sheets { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .sheets a {
    text-decoration: none;
    display: grid;
    grid-template-columns: 52px 1fr 60px;
    align-items: center;
    gap: 16px;
    background: linear-gradient(160deg, color-mix(in srgb, var(--teal) 5%, var(--surface)), var(--surface) 55%);
    border: 1px solid var(--border-soft);
    border-radius: 12px;
    padding: 18px;
    color: var(--text);
    transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .sheets a:hover { transform: translateY(-2px); border-color: var(--teal-dim); box-shadow: var(--shadow); }
  .n {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--teal);
    background: var(--surface2);
    border: 1px solid var(--border-soft);
    border-radius: 10px;
    width: 46px;
    height: 46px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .body { display: flex; flex-direction: column; gap: 3px; }
  .t { font-family: 'Sora', sans-serif; font-weight: 700; font-size: 1rem; }
  .b { color: var(--muted); font-size: 0.9rem; }
  .open {
    font-family: 'Sora', sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--teal-bright);
    text-align: center;
    line-height: 1.3;
  }
  .after { color: var(--faint); font-size: 0.92rem; margin-top: 24px; }
</style>
