---
import Base from '@layouts/Base.astro';

const sheets = [
  {
    slug: 'the-stack',
    title: 'The Kaspa stack',
    blurb: 'All five layers on one page — what each does, what enforces what, and where you build.',
    alt: 'Diagram of the Kaspa stack: your project on top, then Argent, Silverscript, Kaspa Script + Covenants, and Kaspa consensus at the base.',
  },
  {
    slug: 'move-vs-enforce',
    title: 'What changed',
    blurb: 'The before/after of Toccata: Kaspa used to move money — now it enforces rules on it.',
    alt: 'Before and after comparison: before, Alice sends 100 KAS to Bob with no conditions; now, rules are checked between them and the network refuses anything else.',
  },
  {
    slug: 'what-is-a-covenant',
    title: 'What is a covenant?',
    blurb: 'A lock on coins with rules built in — with real example rules and what they unlock.',
    alt: 'A padlock labelled coins-with-rules, example rules like "only Alice can spend" and "needs 2 of 3 to agree", and the things they enable: vaults, escrow, tokens.',
  },
  {
    slug: 'three-things-you-can-build',
    title: 'Three things you can build today',
    blurb: 'Token, vault, or app — which part of the stack each one uses, all on Kaspa L1.',
    alt: 'Three cards: launch a token (uses KCC-20), build a vault (uses Silverscript), build an app (uses Argent) — all ending as covenants on Kaspa L1.',
  },
  {
    slug: 'which-tool',
    title: 'Which tool do I need?',
    blurb: 'One question at a time to the right tool — with an honest maturity label on each.',
    alt: 'Decision flowchart: just want a token leads to KCC-20; rules on some coins leads to Silverscript; a whole app leads to Argent — with maturity labels for each.',
  },
];
---
<Base
  title="Cheat sheets — KasStacker"
  description="The Kaspa stack on five one-page cheat sheets — the stack, covenants, what to build and which tool. Free to save, share and print."
>
  <div class="wrap-narrow">
    <header class="head">
      <p class="eyebrow">Learn · cheat sheets</p>
      <h1>The stack on five pages</h1>
      <p class="lede">
        The whole idea, one page at a time — made for saving, sharing and printing.
        Tap any sheet for the full-size PDF. Free, and always will be.
      </p>
    </header>

    <div class="gallery">
      {sheets.map((s, i) => (
        <figure class="sheet">
          <figcaption>
            <span class="cap-n">{String(i + 1).padStart(2, '0')}</span>
            <span class="cap-body">
              <b>{s.title}</b>
              <span>{s.blurb}</span>
            </span>
            <a class="pdf" href={`/sheets/${s.slug}.pdf`} target="_blank" rel="noopener">PDF ↗</a>
          </figcaption>
          <a href={`/sheets/${s.slug}.pdf`} target="_blank" rel="noopener" aria-label={`Open ${s.title} as a full-size PDF`}>
            <img
              src={`/sheets/img/${s.slug}.webp`}
              srcset={`/sheets/img/${s.slug}-sm.webp 800w, /sheets/img/${s.slug}.webp 1600w`}
              sizes="(max-width: 820px) 94vw, 780px"
              alt={s.alt}
              width="1600"
              height="1029"
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </a>
        </figure>
      ))}
    </div>

    <p class="after">
      Want the interactive versions? The <a href="/learn">6-stop tour</a> covers the same ground with
      quizzes — and you can <a href="/learn/try-it">break a real covenant</a> yourself.
    </p>
  </div>
</Base>

<style>
  .head { padding: 56px 0 28px; }
  .head h1 { font-size: 2rem; font-weight: 800; margin: 8px 0 12px; }
  .lede { color: var(--muted); font-size: 1.05rem; }
  .gallery { display: grid; gap: 36px; }
  .sheet { margin: 0; }
  figcaption {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 10px;
  }
  .cap-n {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 600;
    color: var(--teal);
    flex: none;
  }
  .cap-body { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
  .cap-body b { font-family: 'Sora', sans-serif; font-size: 1.02rem; }
  .cap-body span { color: var(--muted); font-size: 0.87rem; }
  .pdf {
    margin-left: auto;
    flex: none;
    font-family: 'Sora', sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    border: 1px solid var(--teal-dim);
    border-radius: 999px;
    padding: 4px 12px;
  }
  .pdf:hover { text-decoration: none; border-color: var(--teal); }
  .sheet img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid var(--border);
  }
  .sheet > a { display: block; transition: transform 0.15s ease, box-shadow 0.15s ease; border-radius: 12px; }
  .sheet > a:hover { transform: translateY(-2px); box-shadow: var(--shadow); }
  .after { color: var(--faint); font-size: 0.92rem; margin-top: 32px; }
</style>
