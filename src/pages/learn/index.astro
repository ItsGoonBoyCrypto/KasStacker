---
import Base from '@layouts/Base.astro';

const stops = [
  {
    href: '/learn/kaspa-in-60-seconds',
    icon: '⏱️',
    quiz: 'kaspa-in-60-seconds',
    title: 'Kaspa in 60 seconds',
    blurb: 'What Kaspa is, why it is fast, and why for years it could only move money — not make promises about it.',
  },
  {
    href: '/learn/what-toccata-changed',
    icon: '⚡',
    quiz: 'what-toccata-changed',
    title: 'What Toccata changed',
    blurb: 'The 2026 upgrade that taught Kaspa to enforce rules: covenants, chain-checked tokens, ZK verification.',
  },
  {
    href: '/learn/meet-the-stack',
    icon: '🧱',
    quiz: 'meet-the-stack',
    title: 'Meet the stack',
    blurb: 'The five pieces — consensus, Script + Covenants, Silverscript, Argent, KCC-20 — one sentence and one analogy each.',
  },
  {
    href: '/learn/how-it-fits-together',
    icon: '🧩',
    quiz: 'how-it-fits-together',
    title: 'How it fits together',
    blurb: 'Follow one real vault from an idea, through a covenant, to coins on mainnet no one can move against the rules.',
  },
  {
    href: '/learn/try-it',
    icon: '🧨',
    quiz: null,
    title: 'Try to break a covenant',
    blurb: 'Interactive: play the thief against a real, compiling contract — and watch consensus say no.',
  },
  {
    href: '/learn/faq',
    icon: '❓',
    quiz: null,
    title: 'Questions everyone asks',
    blurb: 'Is this like Ethereum smart contracts? What is audited? Where would I actually start?',
  },
];
---
<Base
  title="Learn — KasStacker"
  description="A guided tour of Kaspa's programmability stack for people who don't write code — from 'what is Kaspa' to 'how a covenant protects coins'."
>
  <div class="wrap-narrow">
    <header class="head">
      <p class="eyebrow">Learn</p>
      <h1>Understand it in <em>five minutes</em>.</h1>
      <p class="lede">
        Six short stops, in order, written for people who don't write code. Every technical term
        is explained the first time it appears — and checkpoints along the way turn into
        <a href="/learn/complete">your tour result</a>.
      </p>
      <div class="ctas">
        <a class="btn btn-primary" href="/learn/kaspa-in-60-seconds">Start the tour →</a>
        <a class="btn btn-ghost" href="/learn/cheat-sheets">📄 The cheat sheets</a>
      </div>
    </header>

    <ol class="stops">
      {stops.map((s, i) => (
        <li>
          <a href={s.href}>
            <span class="g-icon" aria-hidden="true">{s.icon}</span>
            <span class="body">
              <span class="t">{s.title}
                <span class="n">stop {i + 1}</span>
                {s.quiz && <span class="done-tick" data-quiz-done={s.quiz} hidden>✓ done</span>}
              </span>
              <span class="b">{s.blurb}</span>
            </span>
            <span class="go">→</span>
          </a>
        </li>
      ))}
    </ol>

    <a class="sheets-callout" href="/learn/cheat-sheets">
      📄 In a hurry? The whole stack on <b>five one-page cheat sheets</b> — view here, print, share →
    </a>
  </div>

  <script>
    // Show ✓ on stops whose checkpoint quiz is complete (per-browser nicety).
    try {
      const state = JSON.parse(localStorage.getItem('ks-quiz') ?? '{}');
      document.querySelectorAll<HTMLElement>('[data-quiz-done]').forEach((el) => {
        if (state[el.dataset.quizDone!]) el.hidden = false;
      });
    } catch { /* storage unavailable — ticks stay hidden */ }
  </script>
</Base>

<style>
  .head { padding: 56px 0 26px; }
  .head h1 {
    font-size: clamp(1.8rem, 4.8vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.01em;
    margin: 8px 0 12px;
  }
  .head h1 em { font-style: normal; color: var(--teal); }
  .lede { color: var(--muted); font-size: 1.05rem; }
  .ctas { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 18px; }

  .stops { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .stops a {
    text-decoration: none;
    display: grid;
    grid-template-columns: 52px 1fr 24px;
    align-items: center;
    gap: 16px;
    background: linear-gradient(160deg, color-mix(in srgb, var(--teal) 5%, var(--surface)), var(--surface) 50%);
    border: 1px solid var(--border-soft);
    border-radius: 12px;
    padding: 18px;
    color: var(--text);
    transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .stops a:hover { transform: translateY(-2px); border-color: var(--teal-dim); box-shadow: var(--shadow); }
  .g-icon {
    font-size: 1.5rem;
    line-height: 1;
    background: var(--surface2);
    border: 1px solid var(--border-soft);
    border-radius: 10px;
    width: 46px;
    height: 46px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .body { display: flex; flex-direction: column; gap: 2px; }
  .t { font-family: 'Sora', sans-serif; font-weight: 700; font-size: 1rem; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .n {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 400;
    font-size: 0.66rem;
    color: var(--faint);
    border: 1px solid var(--border-soft);
    border-radius: 999px;
    padding: 1px 8px;
  }
  .done-tick {
    font-family: 'Sora', sans-serif;
    font-size: 0.66rem;
    font-weight: 700;
    color: var(--teal-ink);
    background: var(--teal);
    border-radius: 999px;
    padding: 2px 9px;
  }
  .b { color: var(--muted); font-size: 0.9rem; }
  .go { color: var(--teal-bright); font-weight: 600; }

  .sheets-callout {
    display: block;
    background: var(--surface);
    border: 1px solid var(--teal-dim);
    border-radius: 10px;
    padding: 13px 16px;
    font-size: 0.95rem;
    color: var(--muted);
    margin-top: 18px;
  }
  .sheets-callout:hover { text-decoration: none; border-color: var(--teal); color: var(--text); }
  .sheets-callout b { color: var(--teal); }
</style>
