---
// Internal: the 1200x630 social-card artboard. Rendered to /og.png by
// scripts/render-og.mjs (headless Chrome) so the card uses the site's real
// fonts and tokens. Not linked from anywhere; noindex.
import '@fontsource/sora/700.css';
import '@fontsource/sora/800.css';
import '@fontsource/instrument-sans/400.css';
import '@fontsource/chakra-petch/700.css';
import Logo from '@components/Logo.astro';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>OG card</title>
  </head>
  <body>
    <div class="card">
      <div class="mark"><Logo size={150} /></div>
      <div class="text">
        <div class="wordmark">Kas<span>Stacker</span></div>
        <div class="tagline">Understand the Kaspa stack.</div>
        <div class="sub">Covenants · Silverscript · Argent · KCC-20 — what they do and how they fit together, in plain language.</div>
        <div class="url">kasstacker.org</div>
      </div>
      <div class="bars" aria-hidden="true">
        <i style="opacity:.45"></i><i style="opacity:.7"></i><i></i>
      </div>
    </div>
    <style>
      * { margin: 0; box-sizing: border-box; }
      body { width: 1200px; height: 630px; overflow: hidden; }
      .card {
        width: 1200px;
        height: 630px;
        background: radial-gradient(1000px 700px at 20% 30%, #10231F 0%, #0A0F14 55%);
        display: flex;
        align-items: center;
        gap: 64px;
        padding: 0 90px;
        position: relative;
        font-family: 'Instrument Sans', sans-serif;
      }
      .mark { filter: drop-shadow(0 0 34px rgba(73, 234, 203, 0.35)); flex: none; }
      .wordmark {
        font-family: 'Chakra Petch', sans-serif;
        font-weight: 700;
        font-size: 96px;
        color: #E8F1EE;
        letter-spacing: 0.01em;
        line-height: 1.05;
      }
      .wordmark span { color: #70C7BA; }
      .tagline {
        font-family: 'Sora', sans-serif;
        font-weight: 700;
        font-size: 34px;
        color: #8FE8D5;
        margin-top: 18px;
      }
      .sub {
        font-size: 25px;
        color: #8FA6A0;
        margin-top: 16px;
        max-width: 640px;
        line-height: 1.45;
      }
      .url {
        font-family: 'Sora', sans-serif;
        font-weight: 700;
        font-size: 24px;
        color: #49EACB;
        margin-top: 30px;
      }
      .bars {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 14px;
        display: flex;
      }
      .bars i { flex: 1; background: #70C7BA; }
    </style>
  </body>
</html>
