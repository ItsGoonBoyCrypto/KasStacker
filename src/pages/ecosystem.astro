---
import Base from '@layouts/Base.astro';
import eco from '@data/ecosystem.json';

const sections = [
  {
    title: null,
    sub: null,
    items: eco.projects,
  },
  {
    title: 'The trading venues',
    sub: 'Six live venues, all covenant-native — between them, more shipped covenant code than the rest of the ecosystem combined.',
    items: eco.venues,
  },
  {
    title: 'Explorers & indexers',
    sub: 'Where covenant activity becomes visible — and queryable.',
    items: eco.explorers,
  },
];
---
<Base
  title="Ecosystem — KasStacker"
  description="Real projects already building on Kaspa's covenant stack — live, verified, and labelled. The proof the stack works."
>
  <div class="wrap">
    <header class="head">
      <p class="eyebrow">Ecosystem</p>
      <h1>Already building on it.</h1>
      <p class="lede">
        The stack isn't a promise — these are live projects running on Kaspa covenants right now.
        Every entry is verified before it appears; origins are labelled
        <span class="origin o-official">official</span> or
        <span class="origin o-community">community</span>, and nothing here is paid placement, ever.
      </p>
    </header>

    {sections.map((s) => (
      <section class="eco-section">
        {s.title && (
          <div class="sec-head">
            <h2 class="sec-title">{s.title}</h2>
            {s.sub && <p class="sec-sub">{s.sub}</p>}
          </div>
        )}
        <div class="grid">
          {s.items.map((p) => (
            <a class="card" href={p.url} rel="noopener">
              <div class="top">
                <span class="icon" aria-hidden="true">{p.icon}</span>
                <div class="names">
                  <h3>{p.name}</h3>
                  <p class="tagline">{p.tagline}</p>
                </div>
                <span class="layer">{p.layer}</span>
              </div>
              <p class="shows">{p.shows}</p>
              <p class="verify">✓ {p.verified}</p>
            </a>
          ))}
        </div>
      </section>
    ))}

    <section>
      <h2 class="sec-title">Currently under review</h2>
      <ul class="review">
        {eco.underReview.map((r) => <li><b>{r.name}</b> — {r.why}</li>)}
      </ul>
    </section>

    <section class="policy panel">
      <h2>How something gets listed</h2>
      <ul>
        <li>Public code, or proof anyone can check on chain — no "trust us" entries.</li>
        <li>It must show the stack doing something real; this is proof, not a directory.</li>
        <li>Alive: listed repositories are watched by the daily status data, and community contracts are re-checked against the current compiler daily by
          <a href="https://github.com/ItsGoonBoyCrypto/KasStacker/actions/workflows/verify-community-examples.yml" rel="noopener">this site's CI</a>.</li>
        <li>Origin always labelled — official or community.</li>
        <li>No paid placement. Suggest an entry via
          <a href="https://github.com/ItsGoonBoyCrypto/KasStacker" rel="noopener">the site repo</a>.</li>
      </ul>
    </section>

    <p class="crossref">
      Building one of these yourself? The <a href="/build/examples">code worth reading</a> and the
      <a href="/build">zero-to-first-covenant path</a> are next door.
    </p>
  </div>
</Base>

<style>
  .head { padding: 56px 0 30px; }
  .head h1 { font-size: clamp(1.8rem, 4.5vw, 2.5rem); font-weight: 800; letter-spacing: -0.01em; margin: 8px 0 14px; }
  .lede { color: var(--muted); font-size: 1.05rem; max-width: 66ch; }
  .origin {
    font-family: 'Sora', sans-serif;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    border-radius: 999px;
    padding: 2px 9px;
    border: 1px solid;
    white-space: nowrap;
  }
  .o-official { color: var(--teal); border-color: var(--teal); }
  .o-community { color: var(--m-testnet); border-color: var(--m-testnet); }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  @media (max-width: 760px) { .grid { grid-template-columns: 1fr; } }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: linear-gradient(160deg, color-mix(in srgb, var(--teal) 6%, var(--surface)), var(--surface) 45%);
    border: 1px solid var(--border-soft);
    border-radius: 12px;
    padding: 22px;
    color: var(--text);
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .card:hover {
    text-decoration: none;
    transform: translateY(-2px);
    border-color: var(--teal-dim);
    box-shadow: var(--shadow);
  }
  .top { display: flex; align-items: flex-start; gap: 12px; flex-wrap: wrap; }
  .icon { font-size: 1.7rem; line-height: 1; }
  .names { min-width: 0; }
  .eco-section { margin-top: 8px; }
  .eco-section + .eco-section { margin-top: 44px; }
  .eco-section .sec-head { margin-bottom: 16px; }
  .card h3 { font-size: 1.1rem; font-weight: 700; }
  .tagline { color: var(--teal); font-size: 0.85rem; font-weight: 600; margin: 2px 0 0; font-family: 'Sora', sans-serif; }
  .layer {
    margin-left: auto;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.66rem;
    color: var(--faint);
    border: 1px solid var(--border-soft);
    border-radius: 999px;
    padding: 3px 9px;
    white-space: nowrap;
  }
  .shows { color: var(--muted); font-size: 0.93rem; margin: 0; }
  .verify { margin: auto 0 0; color: var(--m-audited); font-size: 0.78rem; }
  .sec-title { font-size: 1.3rem; }
  .review { margin: 0; padding-left: 18px; color: var(--muted); font-size: 0.92rem; }
  .review li { margin-bottom: 6px; }
  .review b { color: var(--text); }
  .policy ul { margin: 0; padding-left: 18px; color: var(--muted); font-size: 0.92rem; }
  .policy li { margin-bottom: 7px; }
  .crossref { color: var(--faint); font-size: 0.9rem; margin-top: 24px; }
</style>
