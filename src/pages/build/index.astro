---
import Base from '@layouts/Base.astro';
import checklist from '@data/build-checklist.json';

const allIds = Object.values(checklist).flat().map((i) => i.id);
const guides = [
  { href: '/build/setup', title: 'Toolchain setup', blurb: 'Rust, the Silverscript compiler and debugger, Argent — or the zero-install route via kascov.io.' },
  { href: '/build/first-covenant', title: 'Your first covenant', blurb: 'A 12-line contract from the official tutorial, compiled and stepped through in the debugger.' },
  { href: '/build/testnet', title: 'Testnet', blurb: 'testnet-10: funding an address, node endpoints, and where to see your covenant on an explorer.' },
  { href: '/build/examples', title: 'Examples worth reading', blurb: 'The official example contracts and apps, from single covenants to multi-actor ICC patterns.' },
];
---
<Base
  title="Build — KasStacker"
  description="From zero to a compiled Kaspa covenant: toolchain setup, a first contract, testnet, and the examples worth reading."
>
  <div class="wrap-narrow">
    <header class="head">
      <p class="eyebrow">Build</p>
      <h1>From reading to shipping</h1>
      <p class="lede">
        Four short guides in order. Every command on these pages is taken verbatim from the
        official repositories and was checked against them on 2026-09-10 — anything this
        site couldn't verify is labelled, not guessed.
      </p>
    </header>
    <div class="progress" data-total={allIds.length} data-ids={allIds.join(',')} hidden>
      <div class="bar-row">
        <div class="bar"><i id="bar-fill"></i></div>
        <span class="count"><b id="done-count">0</b> of {allIds.length}</span>
      </div>
      <p class="pnote">Zero → first covenant. Ticks live on the guide pages and are saved in this browser.
        <button id="progress-reset" type="button">reset</button></p>
    </div>

    <ol class="stops">
      {guides.map((g, i) => (
        <li>
          <a href={g.href}>
            <span class="n">{i + 1}</span>
            <span class="body"><span class="t">{g.title}</span><span class="b">{g.blurb}</span></span>
            <span class="go">→</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</Base>

<style>
  .head { padding: 56px 0 28px; }
  .head h1 { font-size: 2rem; font-weight: 700; margin: 8px 0 12px; }
  .lede { color: var(--muted); font-size: 1.02rem; }
  .stops { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .stops a {
    display: grid;
    grid-template-columns: 44px 1fr 24px;
    align-items: center;
    gap: 16px;
    background: var(--surface);
    border: 1px solid var(--border-soft);
    border-radius: 10px;
    padding: 16px 18px;
    color: var(--text);
  }
  .stops a:hover { text-decoration: none; border-color: var(--teal-dim); box-shadow: var(--shadow); }
  .n {
    font-family: 'Sora', sans-serif; font-weight: 700; font-size: 0.9rem;
    color: var(--teal); background: var(--surface2);
    border: 1px solid var(--border-soft); border-radius: 8px;
    width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;
  }
  .body { display: flex; flex-direction: column; gap: 2px; }
  .t { font-family: 'Sora', sans-serif; font-weight: 600; font-size: 0.98rem; }
  .b { color: var(--muted); font-size: 0.88rem; }
  .go { color: var(--teal-bright); font-weight: 600; }
  .progress {
    background: var(--surface);
    border: 1px solid var(--border-soft);
    border-radius: 10px;
    padding: 14px 18px;
    margin-bottom: 18px;
  }
  .bar-row { display: flex; align-items: center; gap: 14px; }
  .bar { flex: 1; height: 8px; background: var(--surface2); border-radius: 999px; overflow: hidden; }
  .bar i { display: block; height: 100%; width: 0; background: var(--teal); border-radius: 999px; transition: width 0.4s ease; }
  .count { font-family: 'JetBrains Mono', monospace; font-size: 0.78rem; color: var(--muted); white-space: nowrap; }
  .count b { color: var(--teal); }
  .pnote { color: var(--faint); font-size: 0.8rem; margin: 8px 0 0; }
  .pnote button {
    background: none; border: none; color: var(--faint); font-size: 0.8rem;
    text-decoration: underline dotted; cursor: pointer; padding: 0; margin-left: 6px;
  }
  .pnote button:hover { color: var(--text); }
</style>

<script>
  const KEY = 'ks-build-progress';
  const wrap = document.querySelector<HTMLElement>('.progress')!;
  const ids = (wrap.dataset.ids ?? '').split(',').filter(Boolean);
  const render = () => {
    let state: Record<string, boolean> = {};
    try { state = JSON.parse(localStorage.getItem(KEY) ?? '{}'); } catch { return; }
    const done = ids.filter((id) => state[id]).length;
    (document.getElementById('done-count') as HTMLElement).textContent = String(done);
    (document.getElementById('bar-fill') as HTMLElement).style.width = `${ids.length ? (done / ids.length) * 100 : 0}%`;
    wrap.hidden = false;
  };
  try { render(); } catch { /* storage unavailable — keep the panel hidden */ }
  document.getElementById('progress-reset')?.addEventListener('click', () => {
    try { localStorage.removeItem(KEY); } catch { /* ignore */ }
    render();
  });
</script>
