---
import Base from '@layouts/Base.astro';
import checklist from '@data/build-checklist.json';

const allIds = Object.values(checklist).flat().map((i) => i.id);
const guides = [
  {
    href: '/build/setup',
    icon: '🛠️',
    key: 'setup',
    title: 'Toolchain setup',
    blurb: 'Rust, the Silverscript compiler and debugger, Argent — or the zero-install route via kascov.io.',
  },
  {
    href: '/build/first-covenant',
    icon: '📜',
    key: 'first-covenant',
    title: 'Your first covenant',
    blurb: 'A 12-line contract from the official tutorial, compiled and stepped through in the debugger.',
  },
  {
    href: '/build/testnet',
    icon: '🧪',
    key: 'testnet',
    title: 'Testnet',
    blurb: 'testnet-10: funding an address, node endpoints, and seeing your covenant on an explorer.',
  },
  {
    href: '/build/examples',
    icon: '📚',
    key: 'examples',
    title: 'Code worth reading',
    blurb: 'Official examples and CI-verified community contracts, in an order that matches the stack.',
  },
  {
    href: '/build/real-contract',
    icon: '🔬',
    key: null,
    title: 'Read a real contract',
    blurb: "KaspaRocket's live limit-order escrow, annotated — the guards, the fee law, and the attack it blocks.",
  },
  {
    href: '/build/help',
    icon: '🆘',
    key: null,
    title: 'Get help',
    blurb: 'Stuck? The repos, channels and fallbacks where covenant questions actually get answered.',
  },
];
const counts = Object.fromEntries(
  Object.entries(checklist).map(([k, items]) => [k, items.map((i) => i.id)]),
);
---
<Base
  title="Build — KasStacker"
  description="From zero to a compiled Kaspa covenant: toolchain setup, a first contract, testnet, and the code worth reading — every command container-proven."
>
  <div class="wrap-narrow">
    <header class="head">
      <p class="eyebrow">Build</p>
      <h1>Zero → your first <em>covenant</em>.</h1>
      <p class="lede">
        Four guided steps and a lifeline. Every command on these pages runs in a fresh container
        <a href="https://github.com/ItsGoonBoyCrypto/KasStacker/actions/workflows/verify-build-commands.yml" rel="noopener">every week in CI</a> —
        if it's written here, it works. Tick things off as you go; your progress stays in this browser.
      </p>
      <div class="quick">
        <a class="btn btn-primary" href="/build/setup">Start the path →</a>
        <a class="btn btn-ghost" href="https://github.com/ItsGoonBoyCrypto/kasstacker-starter" rel="noopener">Clone the starter template</a>
      </div>
    </header>

    <div class="progress" data-ids={allIds.join(',')} hidden>
      <div class="bar-row">
        <div class="bar"><i id="bar-fill"></i></div>
        <span class="count"><b id="done-count">0</b> of {allIds.length}</span>
      </div>
      <p class="pnote">Zero → first covenant.
        <button id="progress-reset" type="button">reset</button></p>
    </div>

    <ol class="stops">
      {guides.map((g, i) => (
        <li>
          <a href={g.href}>
            <span class="g-icon" aria-hidden="true">{g.icon}</span>
            <span class="body">
              <span class="t">{g.title}
                {g.key && <span class="mini" data-page-count={g.key} data-page-ids={counts[g.key].join(',')} hidden></span>}
              </span>
              <span class="b">{g.blurb}</span>
            </span>
            <span class="go">→</span>
          </a>
        </li>
      ))}
    </ol>

    <p class="eco-line">
      Need convincing it's worth the climb? <a href="/ecosystem">Real projects are already live on this stack →</a>
    </p>
  </div>
</Base>

<style>
  .head { padding: 56px 0 24px; }
  .head h1 {
    font-size: clamp(1.7rem, 4.5vw, 2.4rem);
    font-weight: 800;
    letter-spacing: -0.01em;
    margin: 8px 0 12px;
  }
  .head h1 em { font-style: normal; color: var(--teal); }
  .lede { color: var(--muted); font-size: 1.02rem; }
  .quick { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 18px; }
  .progress {
    background: var(--surface);
    border: 1px solid var(--border-soft);
    border-radius: 10px;
    padding: 14px 18px;
    margin: 22px 0 18px;
  }
  .bar-row { display: flex; align-items: center; gap: 14px; }
  .bar { flex: 1; height: 8px; background: var(--surface2); border-radius: 999px; overflow: hidden; }
  .bar i { display: block; height: 100%; width: 0; background: linear-gradient(90deg, var(--teal), var(--teal-bright)); border-radius: 999px; transition: width 0.4s ease; }
  .count { font-family: 'JetBrains Mono', monospace; font-size: 0.78rem; color: var(--muted); white-space: nowrap; }
  .count b { color: var(--teal); }
  .pnote { color: var(--faint); font-size: 0.8rem; margin: 8px 0 0; }
  .pnote button {
    background: none; border: none; color: var(--faint); font-size: 0.8rem;
    text-decoration: underline dotted; cursor: pointer; padding: 0; margin-left: 6px;
  }
  .pnote button:hover { color: var(--text); }
  .stops { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; counter-reset: step; }
  .stops a {
    text-decoration: none;
    display: grid;
    grid-template-columns: 52px 1fr 24px;
    align-items: center;
    gap: 16px;
    background: linear-gradient(160deg, color-mix(in srgb, var(--teal) 5%, var(--surface)), var(--surface) 50%);
    border: 1px solid var(--border-soft);
    border-radius: 12px;
    padding: 18px;
    color: var(--text);
    transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .stops a:hover { text-decoration: none; transform: translateY(-2px); border-color: var(--teal-dim); box-shadow: var(--shadow); }
  .g-icon {
    font-size: 1.5rem;
    line-height: 1;
    background: var(--surface2);
    border: 1px solid var(--border-soft);
    border-radius: 10px;
    width: 46px;
    height: 46px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .body { display: flex; flex-direction: column; gap: 2px; }
  .t { font-family: 'Sora', sans-serif; font-weight: 700; font-size: 1rem; display: flex; align-items: center; gap: 10px; }
  .mini {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    font-weight: 400;
    color: var(--teal);
    border: 1px solid var(--teal-dim);
    border-radius: 999px;
    padding: 1px 8px;
  }
  .mini.done { color: var(--teal-ink); background: var(--teal); border-color: var(--teal); }
  .b { color: var(--muted); font-size: 0.9rem; }
  .go { color: var(--teal-bright); font-weight: 600; }
  .eco-line { margin-top: 22px; color: var(--faint); font-size: 0.92rem; }
</style>

<script>
  const KEY = 'ks-build-progress';
  const read = (): Record<string, boolean> => {
    try { return JSON.parse(localStorage.getItem(KEY) ?? '{}'); } catch { return {}; }
  };
  const wrap = document.querySelector<HTMLElement>('.progress');
  const render = () => {
    const state = read();
    if (wrap) {
      const ids = (wrap.dataset.ids ?? '').split(',').filter(Boolean);
      const done = ids.filter((id) => state[id]).length;
      (document.getElementById('done-count') as HTMLElement).textContent = String(done);
      (document.getElementById('bar-fill') as HTMLElement).style.width = `${ids.length ? (done / ids.length) * 100 : 0}%`;
      wrap.hidden = false;
    }
    document.querySelectorAll<HTMLElement>('[data-page-ids]').forEach((m) => {
      const ids = (m.dataset.pageIds ?? '').split(',').filter(Boolean);
      const done = ids.filter((id) => state[id]).length;
      m.textContent = `${done}/${ids.length}`;
      m.classList.toggle('done', done === ids.length && ids.length > 0);
      m.hidden = false;
    });
  };
  try { render(); } catch { /* storage unavailable */ }
  document.getElementById('progress-reset')?.addEventListener('click', () => {
    try { localStorage.removeItem(KEY); } catch { /* ignore */ }
    render();
  });
</script>
