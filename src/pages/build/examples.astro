---
import Base from '@layouts/Base.astro';
import Checklist from '@components/Checklist.astro';
import status from '@data/status.json';

type RepoStatus = { lastCommit: string };
const repos = status.repos as Record<string, RepoStatus>;
const push = (slug: string) => repos[slug] ? repos[slug].lastCommit.slice(0, 10) : null;

const official = [
  {
    name: 'Silverscript test examples',
    layer: 'Silverscript',
    shows: 'Small single-purpose contracts — the shortest real code in the ecosystem',
    url: 'https://github.com/kaspanet/silverscript/tree/master/silverscript-lang/tests/examples',
    repo: 'kaspanet/silverscript',
    verified: 'run weekly by this site’s CI',
  },
  {
    name: 'KCC20 book',
    layer: 'Silverscript / KCC-20',
    shows: 'The token patterns: how covenant-native tokens are actually built',
    url: 'https://kaspanet.github.io/silverscript/kcc20-book/',
    repo: 'kaspanet/silverscript',
    verified: 'official docs',
  },
  {
    name: 'KCCs — the conventions',
    layer: 'Standards',
    shows: 'Kaspa Calls for Conventions: covenant ABI, authority schemes, and the draft fungible-token (KCC-20) specification',
    url: 'https://kccs.dev',
    repo: 'kaspanet/kccs',
    verified: 'draft status shown per document',
  },
  {
    name: 'Argent examples',
    layer: 'Argent',
    shows: 'tickets, stones, toy_chess, closed/open ICC — actor apps end to end',
    url: 'https://github.com/argent-lang/argent/tree/master/examples',
    repo: 'argent-lang/argent',
    verified: 'built weekly by this site’s CI',
  },
  {
    name: 'Argent playground',
    layer: 'Argent',
    shows: 'Client-side usage of built artifacts, including a DEX example',
    url: 'https://github.com/argent-lang/argent-playground',
    repo: null,
    verified: 'official repo',
  },
  {
    name: 'kasstacker-starter',
    layer: 'Silverscript',
    shows: 'This site’s template: SimpleCovenant + args + compile script, working on the first try',
    url: 'https://github.com/ItsGoonBoyCrypto/kasstacker-starter',
    repo: null,
    verified: 'its own CI re-proves the compile weekly',
  },
];

const community = [
  {
    name: 'KaspaRocket venue contracts',
    layer: 'Silverscript',
    shows: 'A live trading venue publishing its real contracts: escrow buy/sell + LP AMM, with tests and a pinned compiler revision',
    url: 'https://github.com/La-Gauffre/KaspaRocket-Silverscript-Contract',
    repo: null,
    verified: '3/3 parse vs v1.0.0 · venue live on chain',
  },
  {
    name: 'toccata-covenant-tools',
    layer: 'Silverscript · Covenants',
    shows: 'Transaction builders plus small contracts, with on-chain measurement notes',
    url: 'https://github.com/volkanglm/toccata-covenant-tools',
    repo: null,
    verified: '3/3 parse vs v1.0.0',
  },
  {
    name: 'kcc20-live',
    layer: 'Argent · KCC-20',
    shows: 'The first third-party Argent contract this site has verified — a KCC-20 token in .ag, with offline Rust transaction examples',
    url: 'https://github.com/Manyfestation/kcc20-live',
    repo: null,
    verified: 'builds with argentc in CI (re-checked weekly)',
  },
];
---
<Base
  title="Code worth reading — KasStacker"
  description="The covenant code worth learning from — official examples and CI-verified community contracts, every entry checked before listing."
>
  <div class="wrap">
    <header class="head">
      <p class="eyebrow">Build · 4 of 4</p>
      <h1>Code worth reading</h1>
      <p class="lede">
        Reading order that matches the stack: single contracts first, token patterns second,
        multi-actor apps last. Every community entry was compile- or parse-checked against the
        current compiler before listing, and is re-checked weekly.
      </p>
      <p class="eco-push">
        ⭐ Looking for the <b>live projects</b> built on this stack — the apps, the oracle, the venues?
        They have their own page now: <a href="/ecosystem">the ecosystem →</a>
      </p>
    </header>

    <div class="table-scroll">
      <table class="data">
        <thead><tr><th>Example</th><th>Layer</th><th>What it demonstrates</th><th>Last push</th><th>Verification</th></tr></thead>
        <tbody>
          {official.map((r) => (
            <tr>
              <td><a href={r.url} rel="noopener">{r.name}</a> <span class="origin o-official">official</span></td>
              <td>{r.layer}</td>
              <td>{r.shows}</td>
              <td class="num">{r.repo && push(r.repo) ? push(r.repo) : <span class="null">—</span>}</td>
              <td class="v">{r.verified}</td>
            </tr>
          ))}
          {community.map((r) => (
            <tr>
              <td><a href={r.url} rel="noopener">{r.name}</a> <span class="origin o-community">community</span></td>
              <td>{r.layer}</td>
              <td>{r.shows}</td>
              <td class="num">{r.repo && push(r.repo) ? push(r.repo) : <span class="null">—</span>}</td>
              <td class="v">{r.verified}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="note">
      Listing policy, the under-review queue, and everything running live on chain:
      <a href="/ecosystem">the ecosystem page</a>.
    </p>

    <Checklist page="examples" />
  </div>
</Base>

<style>
  .head { padding: 56px 0 26px; }
  .head h1 { font-size: 2rem; font-weight: 700; margin: 8px 0 12px; }
  .lede { color: var(--muted); font-size: 1.02rem; max-width: 70ch; }
  .eco-push {
    background: var(--surface);
    border: 1px solid var(--teal-dim);
    border-radius: 10px;
    padding: 12px 16px;
    font-size: 0.95rem;
    color: var(--muted);
    margin-top: 16px;
  }
  .eco-push b { color: var(--text); }
  .v { font-size: 0.8rem; }
  .origin {
    font-family: 'Sora', sans-serif;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    border-radius: 999px;
    padding: 2px 9px;
    border: 1px solid;
    white-space: nowrap;
  }
  .o-official { color: var(--teal); border-color: var(--teal); }
  .o-community { color: var(--m-testnet); border-color: var(--m-testnet); }
  .note { color: var(--faint); font-size: 0.88rem; margin-top: 16px; }
</style>
