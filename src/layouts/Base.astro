---
// Self-hosted fonts (was Google Fonts — an 809ms render-blocking external
// chain that cost the Lighthouse perf budget; same-origin woff2 instead).
import '@fontsource/sora/400.css';
import '@fontsource/sora/600.css';
import '@fontsource/sora/700.css';
import '@fontsource/sora/800.css';
import '@fontsource/instrument-sans/400.css';
import '@fontsource/instrument-sans/500.css';
import '@fontsource/instrument-sans/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/600.css';
import '@fontsource/chakra-petch/600.css';
import '@fontsource/chakra-petch/700.css';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { LOCALES, COVERED, HTML_LANG, loadDict } from '../i18n/index';

interface Props {
  title: string;
  description: string;
  lang?: string;
}
const { title, description, lang = 'en' } = Astro.props;
const dict = await loadDict(lang);
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

// Learn (and home) exist per-locale; the rest of the site is English.
const learnHref = lang === 'en' ? '/learn' : `/${lang}/learn`;
const homeHref = lang === 'en' ? '/' : `/${lang}/`;
const nav = [
  { href: learnHref, label: dict.ui.nav.learn },
  { href: '/stack', label: dict.ui.nav.stack },
  { href: '/ecosystem', label: dict.ui.nav.ecosystem },
  { href: '/compare', label: dict.ui.nav.compare },
  { href: '/decide', label: dict.ui.nav.decide },
  { href: '/build', label: dict.ui.nav.build },
  { href: '/status', label: dict.ui.nav.status },
];
const path = Astro.url.pathname.replace(/\/$/, '');

// Language switcher: map the current page to its translation when covered,
// otherwise to the locale home. Rendered server-side — no JS.
const rawPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const basePath = lang === 'en' ? rawPath : rawPath.replace(new RegExp(`^/${lang}/`), '/');
const covered = COVERED.includes(basePath);
const allLangs: string[] = ['en', ...LOCALES];
const langNames: Record<string, string> = { en: 'English' };
for (const l of LOCALES) langNames[l] = (await loadDict(l)).ui.langName;
const langTarget = (code: string) => {
  if (code === 'en') return covered ? basePath : '/';
  return covered ? `/${code}${basePath}` : `/${code}/`;
};
---
<!doctype html>
<html lang={HTML_LANG[lang] ?? lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="KasStacker" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="KasStacker — What moved" href="/rss.xml" />
    {covered && allLangs.map((l) => (
      <link rel="alternate" hreflang={HTML_LANG[l] ?? l} href={new URL(langTarget(l), Astro.site)} />
    ))}
    {covered && <link rel="alternate" hreflang="x-default" href={new URL(basePath, Astro.site)} />}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap bar">
        <a href={homeHref} class="home" aria-label="KasStacker home">
          <Logo size={26} />
          <span class="wordmark">Kas<em>Stacker</em></span>
        </a>
        <nav aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} class:list={{ active: path === n.href || path.startsWith(n.href + '/') }}>{n.label}</a>
          ))}
        </nav>
        <details class="lang-menu">
          <summary aria-label={dict.ui.language}>
            <span aria-hidden="true">🌐</span> {lang.toUpperCase()}
          </summary>
          <div class="lang-list">
            {allLangs.map((l) => (
              <a href={langTarget(l)} class:list={{ current: l === lang }} lang={HTML_LANG[l] ?? l}>{langNames[l]}</a>
            ))}
          </div>
        </details>
        <button id="search-open" type="button" aria-label="Search the site">
          <span aria-hidden="true">🔍</span><kbd>Ctrl K</kbd>
        </button>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <dialog id="search-dlg" aria-label="Site search">
      <div id="search-box"></div>
      <p class="search-hint">Esc to close</p>
    </dialog>

    <script>
      const dlg = document.getElementById('search-dlg') as HTMLDialogElement;
      let ready = false;
      const load = (tag: 'link' | 'script', attrs: Record<string, string>) =>
        new Promise<void>((resolve, reject) => {
          const el = document.createElement(tag);
          Object.assign(el, attrs);
          el.onload = () => resolve();
          el.onerror = () => reject(new Error('pagefind assets missing'));
          document.head.appendChild(el);
        });
      const open = async () => {
        dlg.showModal();
        if (!ready) {
          try {
            await load('link', { rel: 'stylesheet', href: '/pagefind/pagefind-ui.css' });
            await load('script', { src: '/pagefind/pagefind-ui.js' });
            // @ts-expect-error PagefindUI is provided by the loaded script
            new PagefindUI({ element: '#search-box', showSubResults: true, showImages: false });
            ready = true;
          } catch {
            document.getElementById('search-box')!.textContent =
              'Search index not available in dev — it is built with the site.';
          }
        }
        dlg.querySelector('input')?.focus();
      };
      document.getElementById('search-open')?.addEventListener('click', open);
      window.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); dlg.open ? dlg.close() : open(); }
      });
      dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
      // Close the language menu when clicking elsewhere.
      const langMenu = document.querySelector('.lang-menu') as HTMLDetailsElement | null;
      document.addEventListener('click', (e) => {
        if (langMenu?.open && !langMenu.contains(e.target as Node)) langMenu.open = false;
      });
    </script>

    <footer class="site-footer">
      <div class="wrap foot">
        <div>
          <Logo size={20} />
          <span class="wordmark small">Kas<em>Stacker</em></span>
        </div>
        <p>
          An independent guide to Kaspa's programmability stack. Complements
          <a href="https://docs.kaspa.org/toccata" rel="noopener">docs.kaspa.org/toccata</a> and
          <a href="https://kascov.io" rel="noopener">kascov.io</a> — every maturity claim is sourced and dated;
          unverified fields are shown as unverified, never guessed.
        </p>
        <p class="fine">
          <a href="/glossary">Glossary</a>
          · <a href="/changelog">What moved</a>
          · <a href="/rss.xml">RSS</a>
          · <a href="https://github.com/ItsGoonBoyCrypto/KasStacker" rel="noopener">Source on GitHub</a>
          · <a href="https://kas-smiths.org" rel="noopener">Kas Smiths forum</a>
          · <a href="https://t.me/kasparnd" rel="noopener">Core R&D Telegram</a>
          · Data refreshes daily from the chain and the GitHub API.
        </p>
      </div>
    </footer>

    <style>
      .site-header {
        position: sticky;
        top: 0;
        z-index: 10;
        background: color-mix(in srgb, var(--bg) 88%, transparent);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--border-soft);
      }
      .bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        height: 62px;
      }
      .home { display: flex; align-items: center; gap: 10px; color: var(--text); }
      .home:hover { text-decoration: none; }
      .wordmark {
        font-family: 'Chakra Petch', 'Sora', sans-serif;
        font-weight: 700;
        font-size: 1.08rem;
        letter-spacing: 0.01em;
      }
      .wordmark em { font-style: normal; color: var(--teal); }
      .wordmark.small { font-size: 0.9rem; }
      nav { display: flex; gap: 4px; margin-left: auto; }
      nav a {
        font-family: 'Sora', sans-serif;
        font-size: 0.84rem;
        font-weight: 600;
        color: var(--muted);
        padding: 7px 12px;
        border-radius: 7px;
        white-space: nowrap;
      }
      nav a:hover { color: var(--text); text-decoration: none; background: var(--surface2); }
      nav a.active { color: var(--teal); }
      .lang-menu { position: relative; margin-left: 8px; }
      .lang-menu summary {
        list-style: none;
        display: flex;
        align-items: center;
        gap: 6px;
        background: var(--surface2);
        border: 1px solid var(--border-soft);
        border-radius: 8px;
        color: var(--muted);
        font-family: 'Sora', sans-serif;
        font-size: 0.76rem;
        font-weight: 600;
        padding: 7px 10px;
        cursor: pointer;
        white-space: nowrap;
      }
      .lang-menu summary::-webkit-details-marker { display: none; }
      .lang-menu summary:hover { border-color: var(--teal-dim); color: var(--text); }
      .lang-menu[open] summary { border-color: var(--teal); color: var(--text); }
      .lang-list {
        position: absolute;
        right: 0;
        top: calc(100% + 6px);
        z-index: 20;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 10px;
        box-shadow: var(--shadow);
        padding: 8px;
        min-width: 250px;
      }
      .lang-list a {
        color: var(--muted);
        font-size: 0.84rem;
        padding: 7px 10px;
        border-radius: 7px;
        white-space: nowrap;
      }
      .lang-list a:hover { color: var(--text); background: var(--surface2); text-decoration: none; }
      .lang-list a.current { color: var(--teal); font-weight: 700; }
      #search-open {
        display: flex;
        align-items: center;
        gap: 7px;
        background: var(--surface2);
        border: 1px solid var(--border-soft);
        border-radius: 8px;
        color: var(--muted);
        font-size: 0.8rem;
        padding: 6px 10px;
        margin-left: 8px;
        cursor: pointer;
      }
      #search-open:hover { border-color: var(--teal-dim); color: var(--text); }
      #search-open kbd {
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.64rem;
        color: var(--faint);
        border: 1px solid var(--border-soft);
        border-radius: 4px;
        padding: 1px 5px;
      }
      @media (max-width: 720px) { #search-open kbd { display: none; } }
      /* Mobile header: logo + search on the first row, a swipeable
         full-width nav row beneath — nothing gets cut off. */
      @media (max-width: 900px) {
        .bar {
          flex-wrap: wrap;
          height: auto;
          padding-top: 10px;
          padding-bottom: 8px;
          row-gap: 6px;
        }
        .home { order: 1; }
        .lang-menu { order: 2; margin-left: auto; }
        #search-open { order: 2; margin-left: 8px; }
        .lang-list { grid-template-columns: 1fr 1fr; }
        nav {
          order: 3;
          width: 100%;
          margin-left: 0;
          overflow-x: auto;
          -webkit-overflow-scrolling: touch;
          scrollbar-width: none;
        }
        nav::-webkit-scrollbar { display: none; }
        nav a { flex: none; padding: 6px 10px; }
      }
      #search-dlg {
        width: min(640px, 92vw);
        max-height: 76vh;
        background: var(--surface);
        color: var(--text);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 18px 20px;
        box-shadow: var(--shadow);
      }
      #search-dlg::backdrop { background: rgba(0, 0, 0, 0.55); backdrop-filter: blur(2px); }
      .search-hint { color: var(--faint); font-size: 0.75rem; margin: 10px 0 0; }
      #search-dlg {
        --pagefind-ui-primary: var(--teal-bright);
        --pagefind-ui-text: var(--text);
        --pagefind-ui-background: var(--surface);
        --pagefind-ui-border: var(--border);
        --pagefind-ui-tag: var(--surface2);
        --pagefind-ui-border-width: 1px;
        --pagefind-ui-border-radius: 8px;
        --pagefind-ui-font: 'Instrument Sans', sans-serif;
      }
      main { min-height: 60vh; padding-bottom: 96px; }
      .site-footer { border-top: 1px solid var(--border-soft); background: var(--surface); }
      .foot { padding: 36px 24px 44px; }
      .foot > div { display: flex; align-items: center; gap: 8px; margin-bottom: 14px; }
      .foot p { color: var(--muted); font-size: 0.88rem; max-width: 72ch; }
      .foot .fine { color: var(--faint); font-size: 0.8rem; margin-bottom: 0; }
      @media (max-width: 560px) {
        nav a { padding: 7px 8px; font-size: 0.78rem; }
      }
    </style>
  </body>
</html>
